rules_version = '2';

// Spec §3/§6: every document is private to its owner. Question generation and
// page-count validation happen in trusted server code, so clients never write
// quizzes or questions directly.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // A user may edit their own profile but never reassign it.
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if isOwner(uid);
    }

    match /documents/{docId} {
      allow read: if isOwner(resource.data.ownerId);
      allow create: if isOwner(request.resource.data.ownerId);
      // Clients may rename or tag; status and pageCount are server-owned.
      allow update: if isOwner(resource.data.ownerId)
                    && request.resource.data.ownerId == resource.data.ownerId
                    && request.resource.data.pageCount == resource.data.pageCount;
      allow delete: if isOwner(resource.data.ownerId);
    }

    match /quizzes/{quizId} {
      allow read: if isOwner(resource.data.ownerId);
      allow update, delete: if isOwner(resource.data.ownerId);
      // Created by Cloud Functions (Mode A) or the validated CSV import (Mode B).
      allow create: if false;

      match /questions/{questionId} {
        allow read: if isOwner(get(/databases/$(database)/documents/quizzes/$(quizId)).data.ownerId);
        allow write: if false;
      }
    }

    match /attempts/{attemptId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
